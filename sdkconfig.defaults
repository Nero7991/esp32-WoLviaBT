CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y

# OTA: two 1.875 MB app slots, rollback if the new image fails its self-test
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bluetooth: BR/EDR controller only, driven over VHCI by main/bt_wake.c (no host stack)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y

# The setup hotspot sees many idle phone connections; 10 sockets ran out (accept error 23).
CONFIG_LWIP_MAX_SOCKETS=16

# Dynamic frequency scaling (esp-power). Light sleep is blocked by EMAC and BR/EDR anyway.
CONFIG_PM_ENABLE=y
# Per-lock held time and time per CPU mode in /api/power.
CONFIG_PM_PROFILING=y
